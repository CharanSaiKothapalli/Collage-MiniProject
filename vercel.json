{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd keytrace && npm run build:web",
  "outputDirectory": "keytrace/apps/web/dist",
  "installCommand": "cd keytrace && npm install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
