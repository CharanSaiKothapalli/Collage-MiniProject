# ===================================================================
# KEYTRACE: Environment Configuration Template
# Copy this file to .env and configure values before starting services
# ===================================================================

# Environment mode: development | test | production
NODE_ENV=development

# -------------------------------------------------------------------
# Backend API Configuration
# -------------------------------------------------------------------
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Session / Authentication Security
# Generate with: openssl rand -base64 32
JWT_SECRET=development-jwt-secret-do-not-use-in-production-replace-with-64-byte-key
JWT_EXPIRES_IN=7d
COOKIE_NAME=keytrace_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# CSRF Protection Secret
CSRF_SECRET=development-csrf-secret-replace-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20

# -------------------------------------------------------------------
# MongoDB Database Configuration
# -------------------------------------------------------------------
# Provide MongoDB Atlas connection string or local MongoDB URI.
# If left empty in development/test, an embedded MongoDB Memory Server will automatically be used.
MONGODB_URI=mongodb://localhost:27017/keytrace
MONGODB_DB_NAME=keytrace

# -------------------------------------------------------------------
# Python Machine Learning Microservice
# -------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=keytrace-internal-service-secret-token
ML_SERVICE_TIMEOUT_MS=5000

# -------------------------------------------------------------------
# Frontend Web App Configuration
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=KEYTRACE
VITE_CONSENT_VERSION=1.0

# -------------------------------------------------------------------
# Administrative Bootstrap
# -------------------------------------------------------------------
# Set to 'true' to allow automatic initial admin creation on first boot
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@keytrace.local
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePass123!
