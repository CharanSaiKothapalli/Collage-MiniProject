# KEYTRACE Backend API Configuration
# On Render / Railway / Persistent Host: Add these environment variables

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Allow your Vercel frontend URL (or comma-separated URLs)
CORS_ORIGIN=https://your-keytrace-web.vercel.app
TRUST_PROXY=true

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/keytrace?retryWrites=true&w=majority
MONGODB_DB_NAME=keytrace

# Python ML Microservice URL
ML_SERVICE_URL=https://your-keytrace-ml.onrender.com
ML_SERVICE_API_KEY=keytrace-internal-service-secret-token
ML_SERVICE_TIMEOUT_MS=5000

# Security (generate a fresh secret with: openssl rand -base64 64)
JWT_SECRET=replace-with-a-production-random-64-byte-secret-key
JWT_EXPIRES_IN=7d
COOKIE_NAME=keytrace_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
CSRF_SECRET=replace-with-a-production-random-csrf-secret

# Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20

# Admin Bootstrap
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@keytrace.local
ADMIN_BOOTSTRAP_PASSWORD=Admin1234!
